# Copy this file to .env before starting the Docker stack. Every setting below
# is optional; the compose file and API provide the same defaults.

# Host port for the web app.
WEB_PORT=8080

# MongoDB database used by the containerized API. The Mongo host is managed by
# docker compose; do not set RL_MONGODB_URI here unless using a custom setup.
RL_MONGODB_DB=researchlens

# API runtime settings.
RL_LOG_LEVEL=INFO
RL_CORS_ORIGINS=
RL_EMBEDDING_BACKEND=sentence_transformers
RL_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RL_OPENALEX_MAILTO=

# Live search settings.
RL_LIVE_SEARCH_ENABLED=true
RL_LIVE_MIN_RESULTS=8
RL_LIVE_MIN_TOP_SCORE=0.45
RL_LIVE_GOOD_SIMILARITY=0.52
RL_LIVE_LIMIT_PER_SOURCE=25
RL_LIVE_COOLDOWN_HOURS=12

# Search and recommendation tuning.
RL_SEARCH_BACKEND=auto
RL_SEARCH_MIN_SIMILARITY=0.28
RL_HYBRID_SEMANTIC_WEIGHT=0.7
RL_HYBRID_KEYWORD_WEIGHT=0.3
RL_REC_CANDIDATE_POOL=150
RL_REC_GROUP_SIZE=6
