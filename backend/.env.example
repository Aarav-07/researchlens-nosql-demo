# Copy to .env and edit. Never commit .env.
RL_DEBUG=false
RL_LOG_LEVEL=INFO
RL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB ---
# Local community server:
RL_MONGODB_URI=mongodb://localhost:27017
# Atlas (unlocks $search + $vectorSearch); swap the URI and set RL_SEARCH_BACKEND=atlas
# RL_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
RL_MONGODB_DB=researchlens
# auto | atlas | local
RL_SEARCH_BACKEND=auto

# OpenAlex polite pool - your email, optional but recommended
RL_OPENALEX_MAILTO=

# auto | sentence_transformers | hashing
RL_EMBEDDING_BACKEND=auto
RL_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

RL_HYBRID_SEMANTIC_WEIGHT=0.7
RL_HYBRID_KEYWORD_WEIGHT=0.3

# --- live coverage: fetch from sources when a query is poorly covered ---
RL_LIVE_SEARCH_ENABLED=true
RL_LIVE_MIN_RESULTS=8
RL_LIVE_MIN_TOP_SCORE=0.45
RL_LIVE_LIMIT_PER_SOURCE=25
RL_LIVE_COOLDOWN_HOURS=12

# --- recommendations ---
RL_REC_CANDIDATE_POOL=150
RL_REC_GROUP_SIZE=6
