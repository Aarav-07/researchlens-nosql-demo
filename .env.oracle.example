# Copy these settings into a root .env file on the Oracle VM.
# Keep the Atlas connection string private; do not commit the completed .env.
RL_MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
RL_MONGODB_DB=researchlens
RL_LOG_LEVEL=INFO
RL_LIVE_SEARCH_ENABLED=true
WEB_PORT=80